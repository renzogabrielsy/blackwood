{
  "name": "@blackwood/sync-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Blackwood durable sync worker — DBOS-wrapped TypeScript port of the ICTC Python sync engine. Standalone package, NOT part of the Next.js build.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:fixtures": "tsx scripts/gen-norm-fixtures.ts",
    "proof:crash-resume": "tsx scripts/crash-resume-proof.ts",
    "mailclerk:live": "tsx scripts/mailclerk-live-test.ts",
    "parity": "tsx test/parity/runner.ts",
    "build:oracle": "python3 scripts/build_oracle.py",
    "fixtures:build": "python3 scripts/build_fixtures.py",
    "fixtures:snapshot": "python3 scripts/snapshot_db.py"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "^4.23.6",
    "@supabase/supabase-js": "^2.45.0",
    "exceljs": "^4.4.0",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
